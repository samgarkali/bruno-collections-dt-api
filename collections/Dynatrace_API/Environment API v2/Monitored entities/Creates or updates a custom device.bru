    "ipAddresses": [
      "10.0.0.1"
    ],
    "listenPorts": [
      80
    ],
    "properties": {},
    "type": "coffee machine"
  }
}

docs {
  # Creates or updates a custom device

  **Auth:** OAuth (inherited from collection)


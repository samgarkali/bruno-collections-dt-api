meta {
  name: Updates the specified credentials set
  type: http
  seq: 4
}

put {
  url: {{DT_TENANT_URL}}/api/v2/credentials/:id
  body: json
  auth: inherit
}

params:path {
  id: 
}

body:json {
  {
    "allowContextlessRequests": "false",
    "allowedEntities": [
      {
        "id": "jane.doe@example.com",
        "type": "USER"
      },
      {
        "id": "john.smith@example.com",
        "type": "USER"
      },
      {
        "id": "my.with.credentials",
        "type": "APPLICATION"
      }
    ],
    "description": "Sample set of credentials for API documentation",
    "name": "Sample credentials",
    "ownerAccessOnly": false,
    "password": "1234abcd",
    "scope": "SYNTHETIC",
    "scopes": [
      "SYNTHETIC",
      "EXTENSION_AUTHENTICATION"
    ],
    "type": "USERNAME_PASSWORD",
    "user": "john.smith@example.com"
  }
}

docs {
  # Updates the specified credentials set.

  The body must not provide an ID. The ID should be provided in the path.

  **Auth:** OAuth (inherited from collection)

  **Required OAuth scopes:** `environment-api:credentials:write`

  **API token scopes:** credentialVault.write
}

meta {
  name: Lists token metadata by token itself
  type: http
  seq: 3
}

post {
  url: {{DT_TENANT_URL}}/api/v1/tokens/lookup
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "token": "abcdefjhij1234567890"
  }
}

docs {
  # Lists token metadata by token itself


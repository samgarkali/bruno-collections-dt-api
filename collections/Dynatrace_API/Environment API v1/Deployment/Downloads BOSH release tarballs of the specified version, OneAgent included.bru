  type: http
  seq: 1
}

get {
  url: {{DT_TENANT_URL}}/api/v1/deployment/boshrelease/agent/:osType/version/:version
  body: none
  auth: inherit
}

params:query {
  ~skipMetadata: 
  ~networkZone: 

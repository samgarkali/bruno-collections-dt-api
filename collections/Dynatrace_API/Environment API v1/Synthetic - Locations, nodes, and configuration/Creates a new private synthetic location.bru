meta {
  name: Creates a new private synthetic location
  type: http
  seq: 2
}

post {
  url: {{DT_TENANT_URL}}/api/v1/synthetic/locations
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "autoUpdateChromium": true,
    "availabilityLocationNodeOutageDelayInMinutes": 5,
    "availabilityLocationOutage": false,
    "availabilityNodeOutage": false,
    "availabilityNotificationsEnabled": true,
    "deploymentType": "STANDARD",
    "fipsMode": "DISABLED",
    "latitude": 48.306351,
    "longitude": 14.287399,
    "name": "Linz Location",
    "nodes": [
      "93302281"
    ],
    "status": "ENABLED",
    "type": "PRIVATE"
  }
}

docs {
  # Creates a new private synthetic location

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** ExternalSyntheticIntegration
}

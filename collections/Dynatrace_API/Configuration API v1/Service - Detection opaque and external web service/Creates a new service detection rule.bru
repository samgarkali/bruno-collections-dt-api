meta {
  name: Creates a new service detection rule
  type: http
  seq: 2
}

post {
  url: {{DT_TENANT_URL}}/api/config/v1/service/detectionRules/OPAQUE_AND_EXTERNAL_WEB_SERVICE
  body: json
  auth: none
}

params:query {
  ~position: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "conditions": [
      {
        "attributeType": "URL_PATH",
        "compareOperations": [
          {
            "ignoreCase": "false",
            "invert": "false",
            "type": "STRING_CONTAINS",
            "values": [
              "value1",
              "value2"
            ]
          }
        ]
      }
    ],
    "description": "REST API example",
    "detectAsWebRequestService": false,
    "enabled": true,
    "managementZones": [
      "zone 1"
    ],
    "name": "My sample rule",
    "port": {
      "doNotUseForServiceId": "true"
    },
    "type": "OPAQUE_AND_EXTERNAL_WEB_SERVICE",
    "urlPath": {
      "valueOverride": "abc"
    }
  }
}

docs {
  # Creates a new service detection rule

  The body must not provide an ID as it will be automatically assigned.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

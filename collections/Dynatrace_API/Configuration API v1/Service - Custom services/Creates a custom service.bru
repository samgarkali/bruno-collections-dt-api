meta {
  name: Creates a custom service
  type: http
  seq: 2
}

post {
  url: {{DT_TENANT_URL}}/api/config/v1/service/customServices/:technology
  body: json
  auth: inherit
}

params:query {
  ~position: 
}

params:path {
  technology: 
}

body:json {
  {
    "enabled": true,
    "name": "CustomService",
    "queueEntryPoint": false,
    "rules": [
      {
        "className": "com.your.company.ClassName",
        "enabled": true,
        "methodRules": [
          {
            "argumentTypes": [
              "java.lang.String"
            ],
            "methodName": "AMethod",
            "returnType": "void"
          }
        ]
      }
    ]
  }
}

docs {
  # Creates a custom service

  In the body of the request, neither custom service nor its rules can have the ID. All IDs will be generated automatically by Dynatrace.

  **Auth:** OAuth (inherited from collection)

  **Required OAuth scopes:** `settings:objects:write`

  **API token scopes:** WriteConfig
}

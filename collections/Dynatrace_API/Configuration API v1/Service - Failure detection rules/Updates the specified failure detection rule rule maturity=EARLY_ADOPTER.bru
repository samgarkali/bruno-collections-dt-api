meta {
  name: Updates the specified failure detection rule rule maturity=EARLY_ADOPTER
  type: http
  seq: 6
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/service/failureDetection/parameterSelection/rules/:id
  body: json
  auth: none
}

params:path {
  id: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "conditions": [
      {
        "attribute": "SERVICE_NAME",
        "predicate": {
          "ignoreCase": false,
          "type": "STRING_STARTS_WITH",
          "values": [
            "shp",
            "stg_shp"
          ]
        }
      }
    ],
    "description": "for requests from shipping module",
    "enabled": true,
    "fdpId": "FDP_9",
    "id": "R_5",
    "name": "shipping"
  }
}

docs {
  # Updates the specified failure detection rule rule | maturity=EARLY_ADOPTER

  If a rule with the specified ID doesn't exist, a new one is created and appended to the end of the rule list. 

  Rules are evaluated from top to bottom, the first matching rule applies.To enforce a particular order use the reorder request. 

  The failure detection parameter set used by the rule must exist at the time of rule creation.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

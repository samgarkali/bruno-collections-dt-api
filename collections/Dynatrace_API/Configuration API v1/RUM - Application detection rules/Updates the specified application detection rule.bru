meta {
  name: Updates the specified application detection rule
  type: http
  seq: 6
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/applicationDetectionRules/:id
  body: json
  auth: none
}

params:path {
  id: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "applicationIdentifier": "APPLICATION-123456",
    "filterConfig": {
      "applicationMatchTarget": "DOMAIN",
      "applicationMatchType": "EQUALS",
      "pattern": "myapp.example.com"
    },
    "id": "12345678-abcd-1234-abcd-1234567890ab",
    "metadata": {
      "clusterVersion": "Mock version",

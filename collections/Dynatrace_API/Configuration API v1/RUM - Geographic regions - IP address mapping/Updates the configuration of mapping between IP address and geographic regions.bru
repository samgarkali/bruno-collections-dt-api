meta {
  name: Updates the configuration of mapping between IP address and geographic regions
  type: http
  seq: 2
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/geographicRegions/ipAddressMappings
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "ipAddressMappingRules": [
      {
        "ipAddressMappingLocation": {
          "city": null,
          "countryCode": null,
          "latitude": null,
          "longitude": null,
          "regionCode": null
        },
        "ipAddressRange": {
          "address": null,
          "addressTo": null,
          "subnetMask": null
        }
      }
    ]
  }
}

docs {
  # Updates the configuration of mapping between IP address and geographic regions

  **Deprecated**

  The request overwrites the existing configuration. Any rules not presented in the payload will be lost.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

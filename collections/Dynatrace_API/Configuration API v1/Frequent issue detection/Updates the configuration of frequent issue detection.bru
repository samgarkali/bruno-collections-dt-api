meta {
  name: Updates the configuration of frequent issue detection
  type: http
  seq: 2
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/frequentIssueDetection
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "frequentIssueDetectionApplicationEnabled": true,
    "frequentIssueDetectionEnvironmentEnabled": false,
    "frequentIssueDetectionInfrastructureEnabled": true,
    "frequentIssueDetectionServiceEnabled": true
  }
}

docs {
  # Updates the configuration of frequent issue detection

  **Deprecated**

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

docs {
  # Validates the payload for the `POST /reports` request | maturity=EARLY_ADOPTER

  The body must not provide an ID.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

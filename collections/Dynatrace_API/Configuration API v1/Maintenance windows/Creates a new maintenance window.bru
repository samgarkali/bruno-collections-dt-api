meta {
  name: Creates a new maintenance window
  type: http
  seq: 2
}

post {
  url: {{DT_TENANT_URL}}/api/config/v1/maintenanceWindows
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "description": "An example Maintenance window",
    "metadata": {
      "clusterVersion": "Mock version",
      "configurationVersions": [
        4,
        2
      ]
    },
    "name": "Example Window",
    "schedule": {
      "end": "2019-02-27 00:00",
      "recurrence": {
        "dayOfMonth": "23",
        "durationMinutes": "60",
        "startTime": "16:28"
      },
      "recurrenceType": "MONTHLY",
      "start": "2018-08-02 00:00",
      "zoneId": "Europe/Vienna"
    },
    "scope": {
      "entities": [
        "HOST-0000000000123456"
      ],
      "matches": [
        {
          "mzId": "123456789",
          "tagCombination": "AND",
          "tags": [
            {
              "context": "AWS",
              "key": "testkey",
              "value": "testvalue"
            }
          ],
          "type": "HOST"
        }
      ]
    },
    "suppressSyntheticMonitorsExecution": "true",
    "suppression": "DETECT_PROBLEMS_AND_ALERT",
    "type": "UNPLANNED"
  }
}

docs {
  # Creates a new maintenance window

  **Deprecated**

  The body must not provide an ID. An ID is assigned automatically by the Dynatrace server.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

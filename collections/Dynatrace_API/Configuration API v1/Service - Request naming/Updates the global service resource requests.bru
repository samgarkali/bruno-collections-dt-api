meta {
  name: Updates the global service resource requests
  type: http
  seq: 10
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/service/resourceNaming
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "binary": [
      ".exe",
      ".zip"
    ],
    "image": [
      ".jpg",
      ".png",
      ".gif",
      ".jpeg",
      ".bmp",
      ".svg",
      ".ico",
      ".woff",
      ".ttf",
      ".otf"
    ]
  }
}

docs {
  # Updates the global service resource requests.

  Update all extensions which are renamed to `Image` or `Binary`

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

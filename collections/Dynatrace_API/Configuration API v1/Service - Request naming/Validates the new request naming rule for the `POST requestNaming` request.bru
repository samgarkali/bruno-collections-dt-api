meta {
  name: Validates the new request naming rule for the `POST requestNaming` request
  type: http
  seq: 4
}

post {
  url: {{DT_TENANT_URL}}/api/config/v1/service/requestNaming/validator
  body: json
  auth: inherit
}

body:json {
  {
    "conditions": [
      {
        "attribute": "WEBREQUEST_URL_PATH",
        "comparisonInfo": {
          "caseSensitive": false,
          "comparison": "BEGINS_WITH",
          "negate": false,
          "type": "STRING",
          "value": "/url"
        }
      }
    ],
    "enabled": true,
    "namingPattern": "renamed request"
  }
}

docs {
  # Validates the new request naming rule for the `POST /requestNaming` request

  **Auth:** OAuth (inherited from collection)

  **Required OAuth scopes:** `settings:objects:write`

  **API token scopes:** WriteConfig
}

meta {
  name: Creates a new calculated web application metric
  type: http
  seq: 2
}

post {
  url: {{DT_TENANT_URL}}/api/config/v1/calculatedMetrics/rum
  body: json
  auth: none
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "applicationIdentifier": "APPLICATION-1234",
    "dimensions": [
      {
        "dimension": "GeoLocation",
        "topX": 20
      }
    ],
    "enabled": true,
    "metricDefinition": {
      "metric": "UserActionDuration"
    },
    "metricKey": "calc:apps.web.mymetric",
    "name": "MyMetric",
    "userActionFilter": {
      "browserType": "BROWSER-1234",
      "country": "GEOLOCATION-1234",
      "loadAction": true
    }
  }
}

docs {
  # Creates a new calculated web application metric

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

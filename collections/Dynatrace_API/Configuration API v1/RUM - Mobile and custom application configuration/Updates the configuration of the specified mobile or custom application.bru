meta {
  name: Updates the configuration of the specified mobile or custom application
  type: http
  seq: 15
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/applications/mobile/:id
  body: json
  auth: none
}

params:path {
  id: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "apdexSettings": {
      "frustratedOnError": false,
      "frustratingThreshold": 0,
      "toleratedThreshold": 0
    },
    "beaconEndpointType": "CLUSTER_ACTIVE_GATE",
    "beaconEndpointUrl": "string",
    "costControlUserSessionPercentage": 0,
    "iconType": "AMAZON_ECHO",
    "name": "string",
    "optInModeEnabled": false,
    "sessionReplayEnabled": false,
    "sessionReplayOnCrashEnabled": false
  }
}

docs {
  # Updates the configuration of the specified mobile or custom application

  You can't change applicationId and applicationType with this request.

  All other values must be included in the body, depending on the applicationType.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

meta {
  name: Updates the specified mobile session or user action property for an application
  type: http
  seq: 11
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/applications/mobile/:applicationId/userActionAndSessionProperties/:key
  body: json
  auth: none
}

params:path {
  applicationId: 
  key: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "aggregation": "AVERAGE",
    "cleanupRule": "string",
    "displayName": "string",
    "name": "string",
    "origin": "API",
    "serverSideRequestAttribute": "string",
    "storeAsSessionProperty": false,
    "storeAsUserActionProperty": false,
    "type": "DOUBLE"
  }
}

docs {
  # Updates the specified mobile session or user action property for an application

  If the property with the specified ID does not exist, a new property is created.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

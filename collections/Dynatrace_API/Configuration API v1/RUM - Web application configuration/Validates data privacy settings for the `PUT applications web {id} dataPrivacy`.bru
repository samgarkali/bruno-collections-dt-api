meta {
  name: Validates data privacy settings for the `PUT applications web {id} dataPrivacy`
  type: http
  seq: 16
}

post {
  url: {{DT_TENANT_URL}}/api/config/v1/applications/web/:id/dataPrivacy/validator
  body: json
  auth: none
}

params:path {
  id: 
}

headers {

meta {
  name: Pins unpins all symbol files of an app version
  type: http
  seq: 10
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/symfiles/:applicationId/:packageName/:os/:versionCode/:versionName/pinning
  body: json
  auth: none
}

params:path {
  applicationId: 
  packageName: 
  os: 
  versionCode: 
  versionName: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "pinned": false
  }
}

docs {
  # Pins/unpins all symbol files of an app version

  A pinned file will not be deleted automatically, when running out of space.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** DssFileManagement
}

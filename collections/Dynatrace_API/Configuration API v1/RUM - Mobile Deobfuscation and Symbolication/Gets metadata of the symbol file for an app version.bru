meta {
  name: Gets metadata of the symbol file for an app version
  type: http
  seq: 7
}

get {
  url: {{DT_TENANT_URL}}/api/config/v1/symfiles/:applicationId/:packageName/:os/:versionCode/:versionName
  body: none
  auth: none
}

params:path {
  applicationId: 
  packageName: 
  os: 
  versionCode: 
  versionName: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

docs {
  # Gets metadata of the symbol file for an app version

  Only one file per OS and version can exist.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** DssFileManagement
}

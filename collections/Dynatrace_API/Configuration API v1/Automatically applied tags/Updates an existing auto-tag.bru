meta {
  name: Updates an existing auto-tag
  type: http
  seq: 5
}

put {
  url: {{DT_TENANT_URL}}/api/config/v1/autoTags/:id
  body: json
  auth: none
}

params:path {
  id: 
}

headers {
  Authorization: Api-Token {{DT_API_TOKEN}}
}

body:json {
  {
    "description": "sampleDescription",
    "entitySelectorBasedRules": [
      {
        "enabled": true,
        "entitySelector": "type(HOST) AND cpuCores(4)"
      }
    ],
    "name": "sampleAutoTag",
    "rules": [
      {
        "conditions": [
          {
            "comparisonInfo": {
              "caseSensitive": false,
              "negate": false,
              "operator": "BEGINS_WITH",
              "type": "STRING",
              "value": "sample"
            },
            "key": {
              "attribute": "SERVICE_DATABASE_NAME"
            }
          },
          {
            "comparisonInfo": {
              "negate": false,
              "operator": "EXISTS",
              "type": "STRING"
            },
            "key": {
              "attribute": "SERVICE_WEB_SERVER_NAME"
            }
          },
          {
            "comparisonInfo": {
              "caseSensitive": false,
              "negate": false,
              "operator": "BEGINS_WITH",
              "type": "STRING",
              "value": "sample"
            },
            "key": {
              "attribute": "PROCESS_GROUP_CUSTOM_METADATA",
              "dynamicKey": {
                "key": "kubernetes.io/limit-ranger",
                "source": "KUBERNETES"
              },
              "type": "PROCESS_CUSTOM_METADATA_KEY"
            }
          }
        ],
        "enabled": true,
        "propagationTypes": [
          "SERVICE_TO_HOST_LIKE"
        ],
        "type": "SERVICE",
        "valueFormat": "myTagValue {Service:DetectedName}"
      }
    ]
  }
}

docs {
  # Updates an existing auto-tag

  **Deprecated**

  If the auto-tag with the specified ID does not exist, a new auto-tag is created.

  **Auth:** Api-Token only (OAuth not supported by this endpoint). Uses `{{DT_API_TOKEN}}`.

  **API token scopes:** WriteConfig
}

# Tenant base URL (include https://, no trailing slash)
#   SaaS:   https://<env-id>.live.dynatrace.com
#   Sprint: https://<env-id>.sprint.dynatracelabs.com
DT_TENANT_URL=https://<env-id>.live.dynatrace.com

# OAuth access token URL (depends on tenant type)
#   SaaS:   https://sso.dynatrace.com/sso/oauth2/token
#   Sprint: https://sso-sprint.dynatracelabs.com/sso/oauth2/token
DT_TOKEN_URL=https://sso.dynatrace.com/sso/oauth2/token

# OAuth client credentials
DT_CLIENT_ID=dt0s02.XXXXXXXX
DT_CLIENT_SECRET=dt0s02.XXXXXXXX.YYYYYYYY

# Resource URN used in the OAuth token request
DT_URN=<resource-urn>

# API token for endpoints that do not support OAuth
DT_API_TOKEN=dt0c01.XXXXXXXX.YYYYYYYY

# Scopes are NOT set here. Add the scopes your OAuth client needs
# in Bruno: Collection Settings -> Auth -> OAuth 2.0 -> Scope.
